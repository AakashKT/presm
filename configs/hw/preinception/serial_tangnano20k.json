{
    "driver": {
        "name": "matrix"
    },

    "device": {
        "name": "preinception",
        "type": "serial",
        "memory_size_in_bytes": 1e10,

        "rtl": {
            "top_module_src": "tangnano20k_serial.v",
            "top_module": "Tangnano20kUart"
        },

        "fpga": {
            "name": "tangnano20k",
            "start_byte": 1,
            "identity_byte": 2,
            "reset_byte": 3,
            "baud_rate": 9600
        }
    },

    "verification": [
        {
            "name": "sanity",
            "args_host_run": ["host"],
            "args_device_run": ["device"],
            "verify": true
        }
    ]
}