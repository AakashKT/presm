{
    "type": "fpga",

    "driver": {
        "name": "c_accel"
    },

    "device": {
        "name": "inception",
        "rtl": {
            "top_module_src": "uart_interface.v",
            "top_module": "UartInterface"
        }
    },

    "fpga": {
        "name": "tangnano20k",
        "linux_device_path": "/dev/ttyUSB1"
    },

    "verification": [
        {
            "name": "sanity",
            "args_host_run": ["host"],
            "args_device_run": ["device"],
            "verify": false
        }
    ],

    "rtl_testbench": [
        {
            "name": "Command Processor",
            "rtl_src": "command_processor.v",
            "testbench_src": "command_processor_tb.v",
            "enable": true
        },
        {
            "name": "UART Interface",
            "rtl_src": "uart_interface.v",
            "testbench_src": "uart_interface_tb.v",
            "enable": true
        }
    ]
}
